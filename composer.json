{
    "name": "infrangible/m2-catalog-product-option-composite-product",
    "description": "Makes add-on product options from Catalog Product Option Product available on the cart page for editing bundle items from Catalog Product Option Composite.",
    "type": "magento2-module",
    "version": "2.0.0",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Product options",
        "Bundle products",
        "add-on products for bundle items in the cart",
        "edit bundle add-ons in the cart"
    ],
    "homepage": "https://www.infrangible.dev/modules/catalog-product-option-composite-product",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "infrangible/m2-catalog-product-option-composite": "~6.0.3",
        "infrangible/m2-catalog-product-option-product": "~2.0.2",
        "infrangible/m2-foundation": "~3.0.2",
        "magento/framework": "~103.0.6",
        "magento/module-catalog": "~104.0.0",
        "magento/module-configurable-product": "~100.4.0"
    },
    "require-dev": {
        "infrangible/phpstan-magento": "~1.2.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\CatalogProductOptionCompositeProduct\\": "src"
        }
    }
}
