use Infrangible\CatalogProductOptionCompositeProduct\Block\Quote\Item\Bundle\Products\Selection\Options\Type\Product;
use Magento\ConfigurableProduct\Model\Product\Type\Configurable;
use Magento\Framework\Escaper;

/** @var Product $block */
/** @var Escaper $escaper */

$product = $block->getOptionProduct();

if ($product === null) {
    return;
}

$renderer = $block->getOptionRenderer();
$option = $block->getOption();
$itemId = (string)$block->getItem()->getId();
$optionId = (string)$option->getId();
$productId = (string)$product->getId();
$checked = $block->isSelected();
$value = $block->getSelectedValue();
$required = $block->isRequired();
$price = $block->getOptionPrice();
$fieldName = sprintf('cart[%s][options][%s]', $itemId, $optionId);
$fieldId = sprintf('cart_%s_options_%s', $itemId, $optionId);
$requiredContainerId = sprintf('cart-%s-options-%s-container', $itemId, $optionId);
// the swatches look for the checkbox of a configurable product by this ID inside the wrapper of the option
$checkboxId = $product->getTypeId() === Configurable::TYPE_CODE ?
    'checkbox_options_' . $optionId :
    sprintf('cart_%s_checkbox_options_%s', $itemId, $optionId);
$checkboxClass = 'checkbox admin__control-checkbox' . ($required ? ' required' : '') . ' product-custom-option';
$checkboxInit = ['Infrangible_CatalogProductOptionProduct/js/option-checkbox' => ['target' => '#' . $fieldId]];
?>
<div class="field<?= $required ? ' required' : '' ?>">
    <label class="label" for="<?= $escaper->escapeHtmlAttr($checkboxId) ?>">
        <span><?= $escaper->escapeHtml($option->getTitle()) ?></span>
    </label>
    <div class="control">
        <input type="hidden"
               name="<?= $escaper->escapeHtmlAttr($fieldName) ?>"
               id="<?= $escaper->escapeHtmlAttr($fieldId) ?>"
               value="<?= $escaper->escapeHtmlAttr($value) ?>">
        <?php if ($product->getTypeId() === Configurable::TYPE_CODE): ?>
            <?php $swatchRole = 'swatch-option-' . $itemId . '-' . $optionId . '-' . $productId; ?>
            <?php $mediaCallback = $escaper->escapeJs($escaper->escapeUrl($renderer->getMediaCallback())); ?>
            <input type="checkbox"
                   class="<?= $escaper->escapeHtmlAttr($checkboxClass) ?> product-custom-option-configurable"
                   name="checkbox_options[<?= $escaper->escapeHtmlAttr($optionId) ?>]"
                   id="<?= $escaper->escapeHtmlAttr($checkboxId) ?>"
                   value="<?= $escaper->escapeHtmlAttr($checked ? $value : $productId) ?>"
                   data-mage-init="<?= $escaper->escapeHtmlAttr((string)json_encode($checkboxInit)) ?>"
                   <?= $checked ? 'checked' : '' ?>>
            <div class="swatch-opt-<?= $escaper->escapeHtmlAttr($productId) ?>"
                 data-role="<?= $escaper->escapeHtmlAttr($swatchRole) ?>"></div>
            <script type="text/x-magento-init">
                {
                    "[data-role=<?= $escaper->escapeJs($swatchRole) ?>]": {
                        "productOptionSwatches": {
                            "selectorProduct": ".product-item-details",
                            "onlySwatches": false,
                            "enableControlLabel": true,
                            "numberToShow": <?= (int)$renderer->getNumberSwatchesPerProduct() ?>,
                            "jsonConfig": <?= /* @noEscape */ $renderer->getJsonConfig() ?>,
                            "jsonSwatchConfig": <?= /* @noEscape */ $renderer->getJsonSwatchConfig() ?>,
                            "mediaCallback": "<?= /* @noEscape */ $mediaCallback ?>",
                            "jsonSwatchImageSizeConfig": <?= /* @noEscape */ $renderer->getJsonSwatchSizeConfig() ?>,
                            "showTooltip": <?= (int)$renderer->getShowSwatchTooltip() ?>
                        }
                    }
                }
            </script>
        <?php else: ?>
            <div class="field choice admin__field admin__field-option">
                <input type="checkbox"
                       class="<?= $escaper->escapeHtmlAttr($checkboxClass) ?>"
                       name="checkbox_options[<?= $escaper->escapeHtmlAttr($optionId) ?>]"
                       id="<?= $escaper->escapeHtmlAttr($checkboxId) ?>"
                       value="<?= $escaper->escapeHtmlAttr($productId) ?>"
                       data-selector="<?= $escaper->escapeHtmlAttr($fieldName) ?>"
                       data-price="<?= $escaper->escapeHtmlAttr((string)$renderer->getCurrencyByStore($price)) ?>"
                       data-mage-init="<?= $escaper->escapeHtmlAttr((string)json_encode($checkboxInit)) ?>"
                       <?= $checked ? 'checked' : '' ?>>
                <label class="label admin__field-label" for="<?= $escaper->escapeHtmlAttr($checkboxId) ?>">
                    <span><?= $escaper->escapeHtml($product->getName()) ?></span>
                    <?= /* @noEscape */ $renderer->formatPrice($price) ?>
                </label>
            </div>
            <?php if ($required): ?>
                <span id="<?= $escaper->escapeHtmlAttr($requiredContainerId) ?>"></span>
            <?php endif; ?>
        <?php endif; ?>
    </div>
</div>
